<Window x:Class="ShapesDrawing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рисование фигур"
        Height="700" Width="900"
        MinWidth="620" MinHeight="520"
        Background="#ECEFF1">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#B0BEC5"
                BorderThickness="2"
                CornerRadius="6"
                Padding="5">
            <Canvas x:Name="Scene"
                    Width="820" Height="400"
                    Background="White"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,10,0,0">

            <GroupBox Header="Треугольник" Padding="6" Margin="0,0,10,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnRandomTriangle" Content="Случайный"
                                Click="BtnRandomTriangle_Click"
                                Padding="8,3" Margin="0,0,6,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Прямоугольник / квадрат" Padding="6" Margin="0,0,10,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtRX" Width="42" Margin="0,0,10,0"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtRY" Width="42"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Ширина" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtRW" Width="42" Margin="0,0,10,0"/>
                        <TextBlock Text="Высота" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtRH" Width="42"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnManualRectangle" Content="Задать"
                    Click="BtnManualRectangle_Click"
                    Padding="8,3"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Сцена" Padding="6" Margin="0,0,0,10">
                <Button x:Name="BtnClear" Content="Очистить всё"
                        Click="BtnClear_Click"
                        Padding="8,3"/>
            </GroupBox>

        </WrapPanel>
    </Grid>
</Window>